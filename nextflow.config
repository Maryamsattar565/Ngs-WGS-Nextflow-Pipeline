profiles {

    conda {
        docker.enabled = false
        conda.enabled  = true
    }

    safe {
        docker.enabled = false
        conda.enabled  = true

        process {
            executor = 'local'
            maxForks = 1
        }
    }

    parallel {
        docker.enabled = false
        conda.enabled  = true

        process {
            executor = 'local'
            maxForks = 2
        }
    }
}

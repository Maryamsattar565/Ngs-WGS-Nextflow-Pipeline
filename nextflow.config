profiles {
    // Recommended for this computer: use the tools already installed in ngs_tools.
    safe {
        docker.enabled = false
        conda.enabled = true
        process {
            executor = 'local'
            maxForks = 1
            beforeScript = 'source "$HOME/miniconda/etc/profile.d/conda.sh" && conda activate ngs_tools'
            withLabel: download  { cpus = 2; memory = '4 GB' }
            withLabel: qc        { cpus = 2; memory = '4 GB' }
            withLabel: alignment { cpus = 4; memory = '12 GB' }
            withLabel: variants  { cpus = 2; memory = '8 GB' }
        }
    }

    // Same installed Conda environment, profile retained for clarity/compatibility.
    conda {
        docker.enabled = false
        conda.enabled = true
        process {
            executor = 'local'
            maxForks = 1
            beforeScript = 'source "$HOME/miniconda/etc/profile.d/conda.sh" && conda activate ngs_tools'
            withLabel: download  { cpus = 2; memory = '4 GB' }
            withLabel: qc        { cpus = 2; memory = '4 GB' }
            withLabel: alignment { cpus = 4; memory = '12 GB' }
            withLabel: variants  { cpus = 2; memory = '8 GB' }
        }
    }

    // Optional profile for a machine with enough resources for two concurrent tasks.
    parallel {
        docker.enabled = false
        conda.enabled = true
        process {
            executor = 'local'
            maxForks = 2
            beforeScript = 'source "$HOME/miniconda/etc/profile.d/conda.sh" && conda activate ngs_tools'
            withLabel: download  { cpus = 2; memory = '4 GB' }
            withLabel: qc        { cpus = 2; memory = '4 GB' }
            withLabel: alignment { cpus = 4; memory = '12 GB' }
            withLabel: variants  { cpus = 2; memory = '8 GB' }
        }
    }

    // Optional Docker execution. Docker must be installed and running.
    docker {
        conda.enabled = false
        docker.enabled = true
        process {
            executor = 'local'
            maxForks = 1
            container = 'ngs-wgs:1.0'
            withLabel: download  { cpus = 2; memory = '4 GB' }
            withLabel: qc        { cpus = 2; memory = '4 GB' }
            withLabel: alignment { cpus = 4; memory = '12 GB' }
            withLabel: variants  { cpus = 2; memory = '8 GB' }
        }
    }
}

// Keep task work files inside the project so resume works and disk use is visible.
workDir = "${projectDir}/work"

profiles {

    conda {
        docker.enabled = false
        conda.enabled  = true
    }

    safe {
        docker.enabled = false
        conda.enabled  = true

        process {
            executor = 'local'
            /*
             * Run one task at a time.
             * Useful for limited WSL/VirtualBox resources.
             */
            maxForks = 1
        }
    }

    parallel {
        docker.enabled = false
        conda.enabled  = true

        process {
            executor = 'local'
            /*
             * Run a maximum of two tasks at a time.
             */
            maxForks = 2
        }
    }
}
